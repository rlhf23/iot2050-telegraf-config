FROM telegraf:latest

# Install SSH server, sudo, and Docker CLI
RUN apt-get update && apt-get install -y \
    openssh-server \
    sudo \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update && apt-get install -y docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Configure SSH
ARG TELEGRAF_SSH_PASSWORD
RUN if [ -z "$TELEGRAF_SSH_PASSWORD" ]; then echo "Error: TELEGRAF_SSH_PASSWORD must be set" && exit 1; fi
RUN mkdir /run/sshd
RUN echo "root:$TELEGRAF_SSH_PASSWORD" | chpasswd
RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config

# Create log directory with correct permissions
RUN mkdir -p /var/log/telegraf && \
    chown -R telegraf:telegraf /var/log/telegraf && \
    chmod 755 /var/log/telegraf

# Add telegraf user to docker group (group ID will be set at runtime)
RUN usermod -aG docker telegraf || true

# SSH login fix
RUN sed 's@session\s*required\s*pam_loginuid.so@session optional pam_loginuid.so@g' -i /etc/pam.d/sshd

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose SSH port
EXPOSE 22

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["telegraf"]
