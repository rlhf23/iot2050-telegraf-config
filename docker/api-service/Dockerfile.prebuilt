# Simple Dockerfile using pre-built binary
# No compilation needed - just copy and run!
# Uses musl binaries for maximum portability
# Use TARGETARCH build arg to select architecture: arm64 or amd64

FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates libssl3

WORKDIR /app

# Accept TARGETARCH build argument (default to arm64 for backward compatibility)
ARG TARGETARCH=arm64

# Copy pre-built binary for the target architecture
COPY api-service/docker-api-service-${TARGETARCH} /app/docker-api-service

# Make it executable
RUN chmod +x /app/docker-api-service

# Expose port
EXPOSE 8000

# Run the binary
CMD ["/app/docker-api-service"]
