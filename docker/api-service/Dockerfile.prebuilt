# Simple Dockerfile using pre-built binary
# No compilation needed - just copy and run!

FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    wget \
    libgcc

WORKDIR /app

# Copy pre-built binary
# This binary should be built by GitHub Actions or locally
COPY api-service/docker-api-service /app/docker-api-service

# Make it executable
RUN chmod +x /app/docker-api-service

# Expose port
EXPOSE 8000

# Run the binary
CMD ["/app/docker-api-service"]
